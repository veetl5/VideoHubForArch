{
  "v": 1,
  "kind": "thumbstudio-template",
  "id": "cutaway-inside-view",
  "name": "Cutaway / show the inside",
  "desc": "An architectural cutaway of a building, vehicle or place; interior sections layer by layer with pointer arrows.",
  "format": "16:9",
  "tags": ["cutaway", "architecture", "schematic", "science", "technical"],
  "slots": {
    "TITLE": { "label": "Main title", "default": "WHAT'S HIDDEN INSIDE?" },
    "SUBJECT": { "label": "Structure / vehicle in cutaway", "default": "a nuclear bunker complex beneath a mountain" },
    "SECTION1": { "label": "Key section 1", "default": "Secret Control Room" },
    "SECTION2": { "label": "Key section 2", "default": "Escape Tunnel" }
  },
  "camera": {
    "shot": "wide",
    "angle": "low",
    "lens": 24,
    "horizon": 0.45,
    "dof": 0.15
  },
  "light": {
    "azimuth": 45,
    "key": "cool",
    "time": "blue-hour",
    "contrast": 0.7,
    "rim": true
  },
  "style": {
    "preset": "cutaway-architecture",
    "palette": ["#0f172a", "#0284c7", "#f59e0b"]
  },
  "text": {
    "policy": "overlay",
    "reserve": true
  },
  "layers": [
    {
      "type": "background",
